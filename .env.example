# ---------------------------------------------------------------------------
# Vanigar Sangam Management System — environment template
#
# Copy to `.env` for local development. NEVER put real credentials, real
# database URLs, real API keys or production secrets in this file.
# `.env` is git-ignored; only this template is committed.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
# Read from the process environment; the API also loads a local `.env` file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Web application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL) -----------------------------------------------------
# Supply DATABASE_URL or discrete DB_* parameters for local connection
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/vanigar_sangam
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vanigar_sangam
DB_USER=postgres
DB_PASSWORD=replace-with-local-postgres-password
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000

# Session — placeholder, replace with a long random value in .env only ------
SESSION_SECRET=replace-with-a-long-random-string

# Documents storage — backend decision pending ------------------------------
# DOCUMENT_STORAGE_DRIVER=
