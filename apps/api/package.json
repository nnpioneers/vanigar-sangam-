{
  "name": "@vanigar/api",
  "version": "0.1.0",
  "private": true,
  "description": "Vanigar Sangam REST API — HTTP/application layer shell with a health endpoint.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "typecheck": "tsc -b",
    "test:db": "tsx src/database/verify.ts",
    "test:schema": "tsx src/database/verify-schema.ts",
    "test:password": "tsx src/services/password.service.test.ts",
    "test:session": "tsx src/services/session.service.test.ts",
    "test:middleware": "tsx src/middleware/auth.middleware.test.ts",
    "test:auth-api": "tsx src/routes/auth.integration.test.ts",
    "test:auth": "tsx src/services/password.service.test.ts && tsx src/services/session.service.test.ts && tsx src/middleware/auth.middleware.test.ts && tsx src/routes/auth.integration.test.ts",
    "test:transaction": "tsx src/database/transaction.test.ts",
    "test:repository": "tsx src/repositories/repository.test.ts",
    "test:errors": "tsx src/errors/app-error.test.ts",
    "test:request-context": "tsx src/middleware/request-context.middleware.test.ts",
    "test:conventions": "tsx src/database/conventions.test.ts",
    "test:modules": "tsx src/modules/module-boundary.test.ts",
    "test:validation": "tsx src/middleware/validation.middleware.test.ts",
    "test:migration": "tsx src/database/migration.test.ts",
    "test:foundation": "tsx src/test-utils/test-foundation.test.ts",
    "test:cash": "tsx src/modules/cash/cash.test.ts",
    "test:members": "tsx src/modules/members/members.test.ts && tsx src/modules/members/members.api.test.ts && tsx src/modules/members/members.profile.test.ts",
    "test:profile": "tsx src/modules/members/members.profile.test.ts",
    "test:daily-sheets": "tsx src/modules/daily-sheets/daily-sheets.foundation.test.ts && tsx src/modules/daily-sheets/daily-sheets.calculation.test.ts && tsx src/modules/daily-sheets/daily-sheets.api.test.ts",
    "test:collections": "tsx src/modules/collections/collections.test.ts",
    "test:loans": "tsx src/modules/loans/loans.api.test.ts",
    "test:guarantors": "tsx src/modules/guarantors/guarantors.api.test.ts",
    "test:agreements": "tsx src/modules/agreements/agreements.api.test.ts",
    "test:disbursements": "tsx src/modules/disbursements/disbursements.api.test.ts",
    "test:repayments": "tsx src/modules/repayments/repayments.api.test.ts",
    "test:reports": "tsx src/modules/reports/reports.api.test.ts",
    "test:core": "tsx src/database/transaction.test.ts && tsx src/repositories/repository.test.ts && tsx src/errors/app-error.test.ts && tsx src/middleware/request-context.middleware.test.ts && tsx src/database/conventions.test.ts && tsx src/modules/module-boundary.test.ts && tsx src/middleware/validation.middleware.test.ts && tsx src/database/migration.test.ts && tsx src/test-utils/test-foundation.test.ts && tsx src/modules/cash/cash.test.ts && npm run test:members && npm run test:daily-sheets && npm run test:collections && npm run test:loans && npm run test:guarantors && npm run test:agreements && npm run test:disbursements && npm run test:repayments && npm run test:reports",
    "test:backend": "npm run test:auth && npm run test:core",
    "admin:provision": "tsx src/scripts/provision-admin.ts",
    "db:migrate": "tsx src/database/run-migrations.ts",
    "db:migrate:status": "tsx src/database/migration-status.ts"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@vanigar/config": "*",
    "@vanigar/shared-types": "*",
    "@vanigar/validation": "*",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
